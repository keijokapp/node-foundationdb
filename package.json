{
  "name": "@arbendium/foundationdb",
  "version": "0.1.0",
  "description": "Node.js bindings for the FoundationDB database",
  "keywords": [
    "foundationdb",
    "fdb",
    "database",
    "NoSQL",
    "ACID"
  ],
  "homepage": "https://foundationdb.org",
  "license": "MIT",
  "type": "module",
  "exports": {
    "import": "./lib/index.js",
    "require": "./dist/index.js",
    "types": "./lib/index.d.ts"
  },
  "main": "./dist/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "binding.gyp",
    "dist",
    "lib",
    "prebuilds",
    "src"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint lib scripts test",
    "prebuild": "prebuildify --napi --strip",
    "prepare": "rm -rf dist/*.js dist/*.ts && tsc -p tsconfig.commonjs.json",
    "prepublishOnly": "ls -ld prebuilds/darwin-arm64/@arbendium+foundationdb.node prebuilds/darwin-x64/@arbendium+foundationdb.node prebuilds/linux-x64/@arbendium+foundationdb.node",
    "test": "mocha test/*.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "fdb-tuple": "^1.0.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@arbendium/eslint-config-base": "^2.1.0",
    "@types/bindings": "^1.5.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.11.9",
    "@types/xml2js": "^0.4.14",
    "chalk": "^5.4.1",
    "eslint": "^9.26.0",
    "mocha": "^11.2.2",
    "prebuildify": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "xml2js": "^0.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keijokapp/node-foundationdb.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "gypfile": true
}
